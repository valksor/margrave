{
  "mutate": ["src/bm25.ts"],
  "commandRunner": {
    "command": "node --import ./test/isolate-store.ts --import ./test/no-vendored-ripwire.ts --test test/bm25.test.ts"
  },
  "coverageAnalysis": "off",
  "ignorePatterns": [
    "/*",
    "!/package.json",
    "!/src",
    "!/examples",
    "/examples/*",
    "!/examples/hosted-mcp.mjs",
    "!/scripts",
    "/scripts/*",
    "!/scripts/ensure-ripwire.mjs",
    "!/scripts/run-mutation-tests.mjs",
    "!/test",
    "/test/fixtures/*",
    "!/test/fixtures/store-v0.2.1",
    "/test/fixtures/store-v0.2.1/store/sources"
  ],
  "concurrency": 6,
  "thresholds": { "high": 100, "low": 100, "break": 100 },
  "reporters": ["clear-text", "progress", "html"],
  "htmlReporter": {
    "fileName": "coverage/stryker.html"
  }
}
