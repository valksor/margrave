{
  "name": "margrave",
  "version": "0.1.5",
  "description": "On-demand skill router: one skill store, ranked search, load on demand.",
  "license": "BSD-3-Clause",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/valksor/margrave.git"
  },
  "homepage": "https://github.com/valksor/margrave#readme",
  "bugs": {
    "url": "https://github.com/valksor/margrave/issues"
  },
  "type": "module",
  "bin": {
    "margrave": "dist/cli.js"
  },
  "exports": {
    "./hosted": {
      "types": "./dist/hosted.d.ts",
      "default": "./dist/hosted.js"
    }
  },
  "files": [
    "dist",
    "scripts/ensure-ripwire.mjs",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@12.21.0",
  "scripts": {
    "prepare": "GIT_CONFIG_GLOBAL=/dev/null GIT_CONFIG_COUNT=0 lefthook install",
    "build": "tsrs && chmod +x dist/cli.js && node scripts/ensure-ripwire.mjs",
    "test": "c8 --check-coverage --100 --all --src src --include 'src/**/*.ts' --reporter=text --reporter=lcov node --import ./test/no-vendored-ripwire.ts --test test/",
    "lint": "oxlint --type-aware --type-check",
    "lint:fix": "oxlint --type-aware --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsrs --noEmit",
    "build:sea": "pnpm run build && node scripts/build-sea.mjs --dev",
    "knip": "knip"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.4.0",
    "stemmer": "2.0.1",
    "yaml": "2.9.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.4.0",
    "@types/node": "26.6.6",
    "c8": "12.0.0",
    "esbuild": "0.28.2",
    "knip": "6.45.1",
    "lefthook": "2.2.2",
    "oxlint": "1.94.0",
    "prettier": "3.10.1",
    "tsrs": "0.25.0-ts7.1.0-beta"
  }
}
